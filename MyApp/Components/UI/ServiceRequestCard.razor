@using MyApp.Models
@using TailwindMerge
@using MyApp.Utils
@inject TwMerge Tw


<!--
    The following design was inspired by v0
    Link: https://v0.dev/
-->

<article class=@Tw.Merge("rounded-xl shadow transition hover:shadow-md p-7 flex flex-col gap-5 border max-h-min lg:max-w-[400px]", Class)>
   <div class="flex gap-3 w-full items-center justify-center">
        <Badge Text="@($"{@ServiceRequest?.Category.ToString().Replace("_", " ")}")" Color="@BadgeColor" />
   </div>

    <div class="h-1 w-3/4 rounded-full bg-gray-300 mx-auto" />
    
    <!--Tile Section-->
    <div class="flex flex-col gap-1">
        <h3 class="mt-0.5 text-wrap break-words text-xl text-gray-900 font-bold">@ServiceRequest.Title</h3>

        <div class="text-sm/relaxed w-full text-wrap break-words text-gray-500 text-muted-foreground">
            Created at @(String.Format($"{ServiceRequest.CreatedAt:dd MMM yyyy}")) by @ServiceRequest.CreatedBy
        </div>
    </div>


    <!--Description-->
    <p class="text-sm mt-2 w-full text-wrap break-words text-muted-foreground text-gray-500">
        @ServiceRequest.Description
    </p>


    <!--Event Details-->
    @if (ServiceRequest.Location != null)
    {
        <div class="flex flex-col gap-2 mt-3">

            <!--Location-->
            <div class="text-sm flex w-full gap-2 items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-map-pin size-4">
                    <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
                <span class="font-semibold">Location:</span>
                <span class="text-wrap break-words">@(ServiceRequest?.Location)</span>
            </div>




            <!--Category-->
            <div class="text-sm flex w-full gap-2 items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                       fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                       stroke-linejoin="round" class="lucide lucide-tag size-4">
                       <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
                       <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
                </svg>
                <p class="font-semibold">Category:</p>
                <p class="text-wrap break-words">@(ServiceRequest?.Category.ToString().Replace("_", " "))</p>
            </div>


            <div class="text-sm flex w-full gap-2 items-center">
                <!--  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" class="lucide lucide-tag size-4">
                    <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
                    <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
                </svg> -->

                <svg xmlns="http://www.w3.org/2000/svg" 
                width="24" height="24" viewBox="0 0 24 24" 
                fill="none" stroke="currentColor" 
                stroke-width="2" stroke-linecap="round" 
                stroke-linejoin="round" class="lucide-chart-no-axes-combined size-4">
                    <path d="M12 16v5" />
                    <path d="M16 14v7" />
                    <path d="M20 10v11" />
                        <path d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15" />
                        <path d="M4 18v3" />
                        <path d="M8 14v7" />
                </svg>
               


                <p class="font-semibold">Status:</p>
                <p class="text-wrap break-words">@(ServiceRequest?.Status.ToString().Replace("_", " "))</p>
            </div>
        </div>
    }
    

    <div class="h-1 w-3/4 rounded-full bg-gray-300 mx-auto" />

    <div class="flex  flex-col gap-3 w-full items-center justify-center">
        <a class="group flex gap-2 cursor-pointer justify-center items-center rounded-md px-2 py-1.5 hover:text-blue-700 hover:bg-blue-50 bg-gray-900 text-white"
           @onclick:stopPropagation @onclick:preventDefault>

            @if (ServiceRequest.Status == ServiceRequestStatus.Submitted)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24"
                     height="24" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" class="lucide lucide-file-check ">
                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                    <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                    <path d="m9 15 2 2 4-4" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.Assigned)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-file-user ">
                    <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                    <path d="M15 18a3 3 0 1 0-6 0" />
                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
                    <circle cx="12" cy="13" r="2" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.In_Progress)
            {
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-loader ">
                    <path d="M12 2v4" />
                    <path d="m16.2 7.8 2.9-2.9" />
                    <path d="M18 12h4" />
                    <path d="m16.2 16.2 2.9 2.9" />
                    <path d="M12 18v4" />
                    <path d="m4.9 19.1 2.9-2.9" />
                    <path d="M2 12h4" />
                    <path d="m4.9 4.9 2.9 2.9" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.Resolved)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" class="lucide lucide-check ">
                    <path d="M20 6 9 17l-5-5" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.On_Hold)
            {
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" class="lucide lucide-circle-pause ">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="10" x2="10" y1="15" y2="9" />
                    <line x1="14" x2="14" y1="15" y2="9" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.Pending_Customer_Action)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-user-round-pen ">
                    <path d="M2 21a8 8 0 0 1 10.821-7.487" />
                    <path d="M21.378 16.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" />
                    <circle cx="10" cy="8" r="5" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.Closed)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24"
                     height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round" class="lucide lucide-ban ">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m4.9 4.9 14.2 14.2" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.Cancelled)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24"
                     height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-square-x ">
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                    <path d="m15 9-6 6" />
                    <path d="m9 9 6 6" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.Escalated)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24"
                     height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-circle-fading-arrow-up ">
                    <path d="M12 2a10 10 0 0 1 7.38 16.75" />
                    <path d="m16 12-4-4-4 4" />
                    <path d="M12 16V8" />
                    <path d="M2.5 8.875a10 10 0 0 0-.5 3" />
                    <path d="M2.83 16a10 10 0 0 0 2.43 3.4" />
                    <path d="M4.636 5.235a10 10 0 0 1 .891-.857" />
                    <path d="M8.644 21.42a10 10 0 0 0 7.631-.38" />
                </svg>
            }
            else if (ServiceRequest.Status == ServiceRequestStatus.Reopened)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" class="lucide lucide-refresh-ccw ">
                    <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                    <path d="M3 3v5h5" />
                    <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
                    <path d="M16 16h5v5" />
                </svg>
            }
            
            <span class="text-sm font-medium">@(ServiceRequest?.Status.ToString().Replace("_", " ")) </span>

            <!--
                <span class="-translate-y-1/2 group-hover:visible invisible absolute start-full top-1/2 ms-4 min-w-max rounded bg-gray-900 px-2 py-1.5 text-xs font-medium text-white">
                Status: @(ServiceRequest?.Status.ToString().Replace("_", " "))
            </span>

              <p class="font-semibold">Status:</p>
            <p class="text-wrap break-words">@(ServiceRequest?.Status.ToString().Replace("_", " "))</p>
            -->
        </a>


        <div class="w-full flex flex-wrap gap-1 justify-between items-center">
            <span class="text-xs font-medium text-muted-foreground text-gray-500">Tracking ID: </span>
            <p class="text-xs font-medium text-muted-foreground text-gray-500">@ServiceRequest?.Id</p>
        </div>

        <!-- @if (EventOrAnnouncement.Type == EventOrAnnouncementType.Announcement)
        {
            <Badge Text="@EventOrAnnouncement.Type.ToString()" Color="@BadgeColor" />
        }
        else
        {
            <Badge Text="@($"{@EventOrAnnouncement.Category.ToString()} {@EventOrAnnouncement.Type.ToString()}")" Color="@BadgeColor" />
        } -->
    </div>

    
</article>




<!-- <Modal IsVisible="@ModalIsVisible" OnClose="@CloseModal" Title=@($"{EventOrAnnouncement.Type.ToString()} Information")>
    <Children>
        <div class="flex flex-col items-center justify-center gap-3">

        </div>
    </Children>
</Modal> -->

@code {
    [Parameter]
    [EditorRequired]
    public ServiceRequest ServiceRequest { get; set; }

    [Parameter]
    public string Class { get; set; }

    string BadgeColor { get; set; }

    protected override void OnInitialized()
    {
        // Attempted to store badge colors in dictionary (found under IssueCategories)
        // however it wasn't working for some reason.
        switch (ServiceRequest.Category)
        {
            case ServiceRequestCategory.Event:
                BadgeColor = "text-violet-700 border-violet-500";
                break;
            case ServiceRequestCategory.Financial:
                BadgeColor = "text-emerald-700 border-emerald-500";
                break;
            case ServiceRequestCategory.Healthcare:
                BadgeColor = "text-green-700 border-green-500";
                break;
            case ServiceRequestCategory.Transportation:
                BadgeColor = "text-fuchsia-700 border-fuchsia-500";
                break;
            case ServiceRequestCategory.Home:
                BadgeColor = "text-pink-700 border-pink-500";
                break;
            case ServiceRequestCategory.Customer_Support:
                BadgeColor = "text-orange-700 border-orange-500";
                break;
            case ServiceRequestCategory.IT:
                BadgeColor = "text-sky-700 border-sky-500";
                break;
            case ServiceRequestCategory.Maintenance:
                BadgeColor = "text-stone-700 border-stone-500";
                break;
            default:
                break;
        }

        StateHasChanged();
    }


    public bool ModalIsVisible { get; set; } = false;

    public void ShowModal()
    {
        ModalIsVisible = true;

        StateHasChanged();
    }

    void CloseModal()
    {
        ModalIsVisible = false;
    }
}
