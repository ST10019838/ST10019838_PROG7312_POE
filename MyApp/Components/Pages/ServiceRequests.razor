@page "/service-requests"
@using MyApp.Components.Forms
@using MyApp.Components.UI
@using MyApp.Models
@using System.Collections.Immutable
@implements IDisposable
@inject StateContainer StateContainer
@using TailwindMerge
@inject TwMerge Tw
@using System.Diagnostics

<section class="grow overflow-auto px-5 pb-7 sm:h-full sm:max-h-screen flex flex-col gap-5">
    <div class="lg:sticky top-0 flex items-center justify-center lg:justify-between w-full gap-3 flex-col lg:flex-row bg-white pt-5 pb-3">
        <!--Tab Selection-->
        <div class="flex items-center w-full gap-2 justify-center lg:justify-start">
            <button @onclick=ShowRecentRequests class=@Tw.Merge(arePersonalRequestsShown ? UnselectedTabClass : SelectedTabClass)>Recent Requests</button>
            <div class="w-0.5 h-7 bg-gray-300 rounded-full" />
            <button @onclick=ShowPersonalRequests class=@Tw.Merge(arePersonalRequestsShown ? SelectedTabClass : UnselectedTabClass)>Your Service Requests</button>
        </div>
        
        <!--Search & Filters-->
        <div class="flex items-center justify-center gap-3 max-w-max flex-wrap sm:flex-nowrap">
            @if (SearchBy.Equals("Status"))
            {
                <div class="flex flex-col gap-1">
                    <span class="text-sm">Search Method</span>
                    <select name="Search Method Selector"
                            @bind="@SearchMethod"
                            @bind:event="onchange"
                            class=@Tw.Merge("w-full rounded-lg border-gray-300 text-gray-700 sm:text-sm border-gray-200 focus:border-blue-500 min-w-max")>
                        <option selected value="BFS">Breadth-first</option>
                        <option value="DFS">Depth-first</option>
                    </select>
                </div>
            }

            <div class="flex flex-col gap-1">
                <span class="text-sm">Search By</span>
                <select name="Search By Selector" 
                        @bind="@SearchBy"
                        @bind:event="onchange"
                        class=@Tw.Merge("w-full rounded-lg border-gray-300 text-gray-700 sm:text-sm border-gray-200 focus:border-blue-500 min-w-max")>
                    <option selected value="Status">Request Status</option>
                    <option value="Category">Request Category</option>
                </select>
            </div>

            <div class="min-w-max">
                <label for="ServiceRequestIdToSearch" class="block text-sm font-medium text-black">
                    Track Request by ID
                </label>

                <!--
                    The following binding was adapted from stackoverflow.com
                    Author: dani herrera
                    Link: https://stackoverflow.com/questions/58222480/change-variable-value-on-input-key-press-on-blazor
                -->
                <input id="ServiceRequestIdToSearch"
                       placeholder="Enter Request ID"
                       class=@Tw.Merge("mt-1 w-full rounded-md sm:text-sm border-gray-200 focus:border-blue-500")
                       @bind="@ServiceRequestIdToSearch"
                       @bind:event="oninput" />
            </div>

            <a @onclick=SearchRequestById class="hover:cursor-pointer inline-block rounded-full border border-blue-600 p-3 text-blue-600 hover:bg-blue-600 hover:text-white focus:outline-none focus:ring active:bg-blue-500">
                <span class="sr-only"> Search </span>

                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke-width="1.5"
                     stroke="currentColor"
                     class="size-4">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
            </a>

            <div class="w-0.5 h-5 bg-gray-300 rounded-full" />

            <!--Clear Fields Icon Button-->
            <a @onclick=ClearSearch class="hover:cursor-pointer inline-block rounded-full border border-blue-600 p-3 text-blue-600 hover:bg-blue-600 hover:text-white focus:outline-none focus:ring active:bg-blue-500">
                <span class="sr-only"> Clear Search </span>

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-eraser size-4">
                    <path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21" />
                    <path d="M22 21H7" />
                    <path d="m5 11 9 9" />
                </svg>
            </a>

            <!--<Search OnSearch="@SearchEventsAndAnnouncements" OnClear="@ClearSearchFilters" />-->
        </div>
    </div>

    @if (arePersonalRequestsShown)
    {
        @if (!StateContainer.HaveCategoriesBeenSearched())
        {
            <div class="grid w-full place-content-center">
                Not enough search data has been collected to recommend events or announcements.
                Please search some categories.
            </div>
        }
        else
        {
            <div class="flex flex-col gap-20">
                @foreach (var item in RecentServiceRequests)
                {
                    <!--  <div class="flex flex-col gap-5">
                        <DateSeparator Date="@item.Key" />

                        <div class="flex flex-wrap w-full gap-6 flex-col lg:flex-row justify-center">
                            @foreach (var eventOrAnnouncement in item.Value)
                            {
                                <EventOrAnnouncementCard EventOrAnnouncement="@eventOrAnnouncement" />
                            }
                        </div>
                    </div> -->
                }
            </div>
        }
    }
    else
    {
        @if (StateContainer.IsServiceRequestStatusGraphEmpty())
        {
            <div class="grid w-full place-content-center">No service requests have been posted yet.</div>

            <button @onclick=AddTestData>Click me to add some test data in the mean time.</button>
        }
        else if ((RecentServiceRequests is null) || !RecentServiceRequests.Any())
        {
            <div class="grid w-full place-content-center">No service requests have been found.</div>
        }
        else
        {
            <div class="flex flex-col gap-20">
                @if (SearchBy.Equals("Status"))
                {
                    @if (SearchMethod.Equals("BFS"))
                    {
                        @foreach (var item in StateContainer.GetServiceRequestStatusUsingBFS())
                        {
                            <div class="flex flex-col gap-5">
                                <div class="flex w-full items-center gap-2">
                                    <div class=@Tw.Merge(LineSeparatorClass) />
                                    <div class="min-w-max text-gray-500">@(item.Key.ToString().Replace("_", " ")) Requests</div>
                                    <div class=@Tw.Merge(LineSeparatorClass) />
                                </div>



                                <div class="flex flex-wrap w-full gap-6 flex-col lg:flex-row justify-center">
                                    @if (!item.Data.Any() || item.Data is null)
                                    {
                                        <div>There are no @(item.Key.ToString().Replace("_", " ")) Service Requests currently</div>
                                    }
                                    else
                                    {
                                        @foreach (var serviceRequest in item.Data)
                                        {
                                            <ServiceRequestCard ServiceRequest="@serviceRequest" />
                                        }
                                    }
                                </div>
                                
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var item in StateContainer.GetServiceRequestStatusUsingDFS())
                        {
                            <div class="flex flex-col gap-5">
                                <div class="flex w-full items-center gap-2">
                                    <div class=@Tw.Merge(LineSeparatorClass) />
                                    <div class="min-w-max text-gray-500">@(item.Key.ToString().Replace("_", " ")) Requests</div>
                                    <div class=@Tw.Merge(LineSeparatorClass) />
                                </div>


                                <div class="flex flex-wrap w-full gap-6 flex-col lg:flex-row justify-center">
                                    @if (!item.Data.Any() || item.Data is null)
                                    {
                                        <div>There are no @(item.Key.ToString().Replace("_", " ")) Service Requests currently</div>
                                    }
                                    else
                                    {
                                        @foreach (var serviceRequest in item.Data)
                                        {
                                            <ServiceRequestCard ServiceRequest="@serviceRequest" />
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                } 
                else
                {
                    @foreach (var item in StateContainer.GetServiceRequestsByCategory())
                    {
                        @if (item.Key == null) continue;

                        <div class="flex flex-col gap-5">
                            <div class="flex w-full items-center gap-2">
                                <div class=@Tw.Merge(LineSeparatorClass) />
                                <div class="min-w-max text-gray-500">@(item?.Key?.ToString().Replace("_", " ")) Requests</div>
                                <div class=@Tw.Merge(LineSeparatorClass) />
                            </div>



                            <div class="flex flex-wrap w-full gap-6 flex-col lg:flex-row justify-center">
                                @if (!item.Data.Any() || item.Data is null)
                                {
                                    <div>There are no @(item?.Key?.ToString().Replace("_", " ")) Service Requests currently</div>
                                }
                                else
                                {
                                    @foreach (var serviceRequest in item.Data)
                                    {
                                        <ServiceRequestCard ServiceRequest="@serviceRequest" />
                                    }
                                }
                            </div>

                        </div>
                    }
                }
            </div>
        }
    }

</section>



@code {
    List<ServiceRequestStatusGraph<List<ServiceRequest>>.Node<List<ServiceRequest>>> RecentServiceRequests { get; set; }
    List<ServiceRequestStatusGraph<List<ServiceRequest>>.Node<List<ServiceRequest>>> PersonalServiceRequests { get; set; }


    string LineSeparatorClass = "h-0.5 w-full rounded-full bg-gray-300";
    string SelectedTabClass = "text-md text-blue-500";
    string UnselectedTabClass = "text-sm text-black/75";
    bool arePersonalRequestsShown { get; set; } = false;
    bool showSearchFilters = false;


    string SearchBy { get; set; } = "Status";
    string SearchMethod { get; set; } = "BFS";
    string ServiceRequestIdToSearch { get; set; }


    List<ServiceRequest> requests = new List<ServiceRequest>
        {
            new ServiceRequest()
    {
        Title = "Event Title",
                Description = "This is a description",
                Location = "Over there street",
                Category = ServiceRequestCategory.Home,
                Status = ServiceRequestStatus.Closed
            },
            new ServiceRequest()
    {
        Title = "Event Title 2",
                Description = "This is a description for Event Title 2",
                Location = "Over there street",
                Category = ServiceRequestCategory.Customer_Support,
                Status = ServiceRequestStatus.Cancelled
            },
            new ServiceRequest()
    {
        Title = "Event Title 3",
                Description = "This is a description for Event Title 3",
                Location = "Over there street",
                Category = ServiceRequestCategory.Maintenance,
                Status = ServiceRequestStatus.Reopened
            }
    };

    void ShowRecentRequests()
    {
        arePersonalRequestsShown = false;
    }

    void ShowPersonalRequests()
    {
        arePersonalRequestsShown = true;


        if (!StateContainer.IsServiceRequestStatusGraphEmpty())
        {
            PersonalServiceRequests = StateContainer.GetServiceRequestStatusUsingBFS();
        }
    }


    void OnSearchByChange()
    {
        
    }

    // Need to adjust
    void SearchRequestById()
    {
        // EventsAndAnnouncements = StateContainer.GetEventsAndAnnouncements(dateSelected, categorySelected);

        // if (arePersonalRequestsShown) ShowRecentRequests();

        // StateHasChanged();
    }

    void ClearSearch()
    {
        // EventsAndAnnouncements = StateContainer.GetEventsAndAnnouncements();

        // StateHasChanged();
    }



    void AddTestData()
    {
        StateContainer.PopulateServiceRequestBasicTree();
        StateContainer.PopulateServiceRequestStatusGraph();

        StateHasChanged();

        RecentServiceRequests = StateContainer.GetServiceRequestStatusUsingBFS();
    }

    protected override void OnInitialized()
    {
        // add to the NavigationManager event
        // Issues = Repository.GetIssues();

        StateContainer.OnChange += StateHasChanged;

        if(!StateContainer.IsServiceRequestStatusGraphEmpty()){
            RecentServiceRequests = StateContainer.GetServiceRequestStatusUsingBFS();
        }
    }

    public void Dispose()
    {
        StateContainer.OnChange -= StateHasChanged;
    }


}
